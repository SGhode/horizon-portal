# ==============================================================================
# Portal Environment Configuration Template (.env.example)
# ==============================================================================
# NOTE: Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# Never expose database credentials, private API keys, or JWT secrets in NEXT_PUBLIC_ variables.
# ==============================================================================

# Node Runtime Environment ("development" | "production" | "test")
NODE_ENV=development

# Portal HTTP Server Port
PORT=3000

# MSW bootstrap toggle ("enabled" | "disabled"); auth remains server-side.
NEXT_PUBLIC_API_MOCKING=enabled

# Application Metadata (Public)
NEXT_PUBLIC_APP_NAME=PeoplePortal
NEXT_PUBLIC_APP_VERSION=2.0.0

# ==============================================================================
# Authentication & Backend Gateway Settings
# ==============================================================================
# Upstream Python Authentication Backend URL
AUTH_BACKEND_URL=http://localhost:8000

# Name of the HTTP-only session cookie
AUTH_COOKIE_NAME=peopleportal_session

# Force secure cookie over HTTPS (set to true in production)
AUTH_COOKIE_SECURE=false

# Development-only mock auth; ignored unless NODE_ENV is exactly "development".
AUTH_DEV_MOCK_ENABLED=true
NEXT_PUBLIC_AUTH_DEMO_ENABLED=true
